# Copy to .env.local for npm run dev. Railway variables are configured on logistic.
DATABASE_URL=postgres://loadlink:loadlink@localhost:5432/loadlink
APP_URL=http://localhost:3000
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters
ORDER_SOURCE=fixture
# Approximate routing is only allowed in development.
ROUTING_MODE=fixture
# Production road routes use Google; OSRM_URL is an optional alternative.
GOOGLE_ROUTES_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
EMAIL_PROVIDER=local
NEXT_PUBLIC_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
